<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep API requests available for the backend rather than serving the SPA.
  RewriteRule ^api(?:/|$) - [L]

  # Serve deployed assets directly and send client-side routes to React.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType "text/html; charset=UTF-8" .html
  AddType "text/css; charset=UTF-8" .css
  AddType "application/javascript; charset=UTF-8" .js
  AddType "application/manifest+json; charset=UTF-8" .webmanifest
  AddType "application/json; charset=UTF-8" .json
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
